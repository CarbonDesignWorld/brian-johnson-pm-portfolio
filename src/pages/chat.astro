---
import Shell from '../layouts/Shell.astro';
import ChatApp from '../components/ChatApp.jsx';
import ChatSidebar from '../components/ChatSidebar.jsx';
---
<Shell path="/chat" chat crumbs={[{ label: 'Ask about Brian', emoji: '💬' }]}
  description="Ask Brian Johnson's AI assistant about his product work, case studies and experience.">
  <ChatSidebar slot="sidebar" client:load />
  <ChatApp client:load />
</Shell>

<style is:global>
  .chat { display: flex; flex-direction: column; align-items: center; padding: 48px 24px 64px; min-height: calc(100vh - 88px); box-sizing: border-box; }
  .chat-inner { width: 100%; max-width: 760px; display: flex; flex-direction: column; flex: 1; }
  .chat-hero { display: flex; flex-direction: column; align-items: center; text-align: center; margin: 96px 0 40px; }
  .chat-hero h1 { margin: 0; font-size: 32px; line-height: 40px; font-weight: 700; }
  .chat-avatar-lg, .chat-avatar-md, .chat-avatar-sm { border-radius: 50%; background: #FFFFFF; border: 1px solid #E9E9E7; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  .chat-avatar-lg { width: 84px; height: 84px; box-shadow: 0 2px 8px rgba(15,15,15,0.08); margin-bottom: 20px; }
  .chat-avatar-lg img { width: 46px; height: 46px; }
  .chat-avatar-md { width: 52px; height: 52px; box-shadow: 0 1px 3px rgba(15,15,15,0.08); }
  .chat-avatar-md img { width: 30px; height: 30px; }
  .chat-avatar-sm { width: 32px; height: 32px; }
  .chat-avatar-sm img { width: 26px; height: 26px; }
  .chat-avatar-lg img, .chat-avatar-md img, .chat-avatar-sm img { border-radius: 50%; object-fit: cover; display: block; }
  .chat-thread { display: flex; flex-direction: column; gap: 20px; margin: 8px 0 32px; }
  .msg-user { align-self: flex-end; max-width: 80%; padding: 10px 14px; border-radius: 12px; background: #F1F1EF; font-size: 15px; line-height: 24px; white-space: pre-line; }
  .msg-ai { display: flex; gap: 12px; }
  .msg-who { font-size: 13px; color: #787774; margin-bottom: 4px; }
  .ai-tag { font-size: 11px; font-weight: 600; padding: 1px 6px; border-radius: 4px; background: #EBF0FD; color: #2A50C4; margin-left: 4px; }
  .ai-tag-white { background: #FFFFFF; margin: 0; }
  .msg-text { font-size: 15px; line-height: 25px; white-space: pre-line; }
  .msg-src { font-size: 13px; color: #787774; margin-top: 10px; }
  .handoff { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 18px; padding: 16px 18px; border: 1px solid #E9E9E7; border-radius: 10px; }
  .handoff > span { flex: 1 1 220px; font-size: 14px; line-height: 22px; }
  .handoff .book { border: 0; cursor: pointer; font-family: inherit; min-height: 40px; padding: 0 16px; }
  .msg-typing { display: flex; gap: 4px; align-items: center; height: 32px; }
  .msg-typing span { width: 6px; height: 6px; border-radius: 50%; background: #91918E; animation: blink 1s infinite ease-in-out; }
  .msg-typing span:nth-child(2) { animation-delay: .15s; } .msg-typing span:nth-child(3) { animation-delay: .3s; }
  @keyframes blink { 0%, 80%, 100% { opacity: .25 } 40% { opacity: 1 } }
  .composer { margin-top: auto; }
  .composer-note { padding: 8px 16px; border-radius: 12px 12px 0 0; background: #EBF0FD; font-size: 13px; color: #2A50C4; display: flex; align-items: center; gap: 8px; }
  .composer-box { border: 1.5px solid #3360E5; border-radius: 0 0 12px 12px; padding: 14px 16px 10px; background: #FFFFFF; }
  .composer-box input { width: 100%; border: 0; outline: none; font: inherit; font-size: 16px; color: #37352F; background: none; padding: 4px 0 14px; }
  .composer-row { display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: #91918E; }
  .send:disabled { opacity: .45; cursor: default; }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; margin-top: 14px; }
  .assistant-tile { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 12px; color: #5F5E5B; }
  .assistant-new { font: inherit; font-size: 12px; color: #787774; background: none; border: 0; cursor: pointer; padding: 0; }
  .new-circle { width: 52px; height: 52px; border-radius: 50%; border: 1px dashed #D3D3D0; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #91918E; }
  button.nav-item { background: none; border: 0; font-family: inherit; cursor: pointer; width: 100%; text-align: left; }
  @media (max-width: 599px) {
    .chat { padding: 24px 16px 32px; }
    .chat-hero { margin: 40px 0 28px; }
    .chat-hero h1 { font-size: 24px; line-height: 32px; }
    .composer-note { font-size: 12px; }
  }
</style>
