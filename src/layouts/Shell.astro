---
// The Notion-style shell every page sits in: sidebar, tab strip, breadcrumb bar.
import '../styles/mockup.css';
import '../styles/site.css';
import TabStrip from '../components/TabStrip.jsx';
import RecentList from '../components/RecentList.jsx';
import Overlays from '../components/Overlays.jsx';
import { SITE, PAGES } from '../data/site.js';

interface Crumb { label: string; emoji: string; href?: string }
interface Props {
  path: string;
  crumbs?: Crumb[];
  description?: string;
  chat?: boolean;
}
const { path, crumbs, description = SITE.description, chat = false } = Astro.props;
const page = PAGES[path] ?? { title: 'Page not found', emoji: '🧭' };
const known = !!PAGES[path];
const docTitle = path === '/' ? SITE.title : `${page.title} · ${SITE.name}`;
const noindex = !known;
const trail: Crumb[] = crumbs ?? [{ label: page.title, emoji: page.emoji }];
const canonical = new URL(path, SITE.url).href;
const workKids = [
  ['/work/prepare', '🌦️', 'Prepare'],
  ['/work/cot', '🎓', 'C.O.T'],
  ['/work/just-hair', '💇🏾‍♀️', 'Just Hair'],
  ['/work/gotukang', '🔧', 'GoTukang'],
];
const cur = (p: string) => (p === path ? { 'aria-current': 'page', class: 'nav-item nav-on' } : { class: 'nav-item' });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{docTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/images/logos/carbon.jpg" />
  <meta property="og:title" content={docTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL('/images/og.jpg', SITE.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<div class="shell">
  <input type="checkbox" id="drawer" class="drawer-toggle" aria-hidden="true" tabindex="-1" />
  <nav aria-label="Site" class="sidebar" id="sidebar">
    <div class="side-scroll">
      <div class="brand">
        <img src="/images/logos/carbon.jpg" alt="" width="26" height="26" />
        <div>Brian Johnson</div>
        <label for="drawer" class="close drawer-close" aria-label="Close menu">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </label>
      </div>

      <div class="icon-row">
        {chat ? (
          <a class="icon-btn" href="/" aria-label="Home"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"></path></svg></a>
          <a class="pill" href="/chat" aria-current="page"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5c0 4.14-3.58 7.5-8 7.5a8.6 8.6 0 0 1-3.36-.68L4 19.5l1.2-3.6A7.1 7.1 0 0 1 4 11.5C4 7.36 7.58 4 12 4s8 3.36 8 7.5z"></path></svg>Chat</a>
        ) : (
          <a class={path === '/' ? 'pill' : 'pill pill-off'} href="/" aria-current={path === '/' ? 'page' : undefined}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"></path></svg>Home</a>
          <a class="icon-btn" href="/chat" aria-label="Chat with Brian's AI assistant"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5c0 4.14-3.58 7.5-8 7.5a8.6 8.6 0 0 1-3.36-.68L4 19.5l1.2-3.6A7.1 7.1 0 0 1 4 11.5C4 7.36 7.58 4 12 4s8 3.36 8 7.5z"></path></svg></a>
        )}
        <a class="icon-btn" href="/contact" data-open="meetings" aria-label="Book a meeting"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path></svg></a>
        <a class="icon-btn" href="#inbox" data-open="inbox" data-inbox-label aria-label="Inbox"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13l2.5-8h13L21 13v6H3z"></path><path d="M3 13h5l1.5 2.5h5L16 13h5"></path></svg><span class="badge" data-inbox-badge hidden aria-hidden="true"></span></a>
        <a class="icon-btn" href="#search" data-open="search" aria-label="Search (Ctrl or Cmd + K)" style="margin-left: auto"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg></a>
      </div>

      <slot name="sidebar" />

      <RecentList client:idle path={path} />

      <div class="nav-group">
        <div class="nav-label">Pages</div>
        <a {...cur('/work')} href="/work"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"></rect><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"></rect><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"></rect><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"></rect></svg>Work</a>
        <div class="nav-kids">
          {workKids.map(([href, emoji, label]) => (
            <a {...cur(href)} href={href}><span aria-hidden="true">{emoji}</span>{label}</a>
          ))}
        </div>
        <a {...cur('/writing')} href="/writing"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"></path><path d="m13.5 6.5 4 4"></path></svg>Writing</a>
        <a {...cur('/photos')} href="/photos"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"></rect><circle cx="9" cy="10" r="1.8"></circle><path d="m4 18 5-5 4 4 3-3 4 4"></path></svg>Photos</a>
        <a {...cur('/contact')} href="/contact"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3.5 6 8.5 7 8.5-7"></path></svg>Contact</a>
      </div>
    </div>
    <div class="side-foot">
      <a class="btn-outline" href="/contact" data-open="meetings"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path></svg>Book a meeting</a>
    </div>
  </nav>
  <label for="drawer" class="backdrop" aria-hidden="true"></label>

  <main class="main">
    <div class="topbars">
      <div class="tabstrip">
        <div class="chrome">
          <label for="drawer" class="chrome-btn menu-btn" aria-label="Open menu" role="button" tabindex="0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"></rect><path d="M9.5 4.5v15"></path></svg></label>
          <button class="chrome-btn hide-phone" type="button" aria-label="Back" data-history="back"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg></button>
          <button class="chrome-btn hide-phone" type="button" aria-label="Forward" data-history="forward"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg></button>
          <a class="phone-brand" href="/">Brian Johnson</a>
        </div>
        <div class="hide-phone tabs-wrap">{known && <TabStrip client:load path={path} />}</div>
      </div>
      <div class="crumbbar">
        <div class="crumbs">
          {trail.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              {c.href ? <a href={c.href}>{c.emoji} {c.label}</a> : <span class="crumb-here">{c.emoji} {c.label}</span>}
            </>
          ))}
        </div>
        <div class="crumb-actions">
          <a class="text-btn" href="/contact" data-open="meetings">Book a meeting</a>
          <button class="chrome-btn hide-phone" type="button" aria-label="Copy link to this page" data-copy-link><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg></button>
        </div>
      </div>
    </div>
    <div id="content" class="content">
      <slot />
    </div>
  </main>
</div>
<div class="toast" role="status" aria-live="polite" hidden></div>
<Overlays client:load />

<script>
  // Panels: any element with data-open opens Meetings, Inbox or Search.
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const opener = t.closest('[data-open]') as HTMLElement | null;
    if (opener) {
      e.preventDefault();
      const drawer = document.getElementById('drawer') as HTMLInputElement | null;
      if (drawer) drawer.checked = false;
      window.dispatchEvent(new CustomEvent('bj:open', { detail: { panel: opener.dataset.open, len: opener.dataset.len } }));
      return;
    }
    const hist = t.closest('[data-history]') as HTMLElement | null;
    if (hist) history[hist.dataset.history === 'back' ? 'back' : 'forward']();
    if (t.closest('[data-copy-link]')) {
      navigator.clipboard?.writeText(location.href).then(() => {
        const toast = document.querySelector('.toast') as HTMLElement;
        toast.textContent = 'Link copied';
        toast.hidden = false;
        setTimeout(() => (toast.hidden = true), 1600);
      });
    }
  });
  // Keyboard access for the menu button (it is a label for the drawer checkbox).
  document.querySelectorAll('.menu-btn').forEach((el) =>
    el.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'Enter' || k === ' ') {
        e.preventDefault();
        (document.getElementById('drawer') as HTMLInputElement).click();
      }
    })
  );
  document.addEventListener('keydown', (e) => {
    const d = document.getElementById('drawer') as HTMLInputElement;
    if (e.key === 'Escape' && d?.checked) d.checked = false;
  });
</script>
</body>
</html>
